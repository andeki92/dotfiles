/.superpowers/
/docs/superpowers/
/worktrees/
**/.DS_Store

# Negate global *.local pattern from ~/.config/git/ignore for stow modules
# whose targets land under ~/.local/ (e.g. <tool>/.local/bin/, <tool>/.local/share/).
!config/*/.local/
!config/*/.local/**

# Claude worktrees
.claude/worktrees

# Rex: each machine's own projects, and the server's state, which lands here
# if stow links all of ~/.config/rex on a machine that had none
config/rex/.config/rex/projects.lua
config/rex/.config/rex/logs/
config/rex/.config/rex/.claude/

# Skill symlinks auto-installed by third-party CLI installers (e.g. hf)
config/claude/.claude/skills/hf-cli
