# macOS-specific Git configuration
# Git Credential Manager handles every host. The blank helper clears the
# osxkeychain entry Homebrew's system gitconfig sets, so GCM is asked alone.
[credential]
guiPrompt = false
helper =
helper = /usr/local/share/gcm-core/git-credential-manager

# gitlab.com gets no helper from files: the blank clears the GCM entry above.
# Your shell adds `!glab auth git-credential` through GIT_CONFIG_* in
# zsh/eager/10-platform.zsh, and the claude launchers strip it, so agent
# sessions reach gitlab.com only through 0th's `1st`.
[credential "https://gitlab.com"]
helper =
