{
  "cleanupPeriodDays": 365,
  "env": {
    "GIT_CONFIG_VALUE_1": "/Users/akle/.config/glab-agent/git-credential",
    "GLAB_CONFIG_DIR": "/Users/akle/.config/glab-agent",
    "SSL_CERT_FILE": "/etc/ssl/cert.pem",
    "CLAUDE_CODE_SUBAGENT_EFFORT": "medium"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(claude --version)"
    ],
    "deny": [
      "EnterPlanMode",
      "ExitPlanMode",
      "DesignSync",
      "NotebookEdit",
      "SendMessage",
      "PushNotification",
      "RemoteTrigger",
      "ReportFindings",
      "ScheduleWakeup",
      "AskUserQuestion",
      "CronCreate",
      "CronDelete",
      "CronList"
    ]
  },
  "disableClaudeAiConnectors": true,
  "disableBundledSkills": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/block-bash-file-edits.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/lint-dispatch.sh\""
          }
        ]
      },
      {
        "matcher": "EnterWorktree|ExitWorktree",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/herdr-worktree.sh\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/herdr-worktree.sh\""
          }
        ]
      },
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/akle/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "disableRemoteControl": true,
  "disableWorkflows": true,
  "disableArtifact": true,
  "statusLine": {
    "type": "command",
    "command": "~/.cargo/bin/claude-statusline",
    "refreshInterval": 1
  },
  "enabledPlugins": {
    "skill-creator@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "akle-skills@skills": true
  },
  "extraKnownMarketplaces": {
    "skills": {
      "source": {
        "source": "git",
        "url": "https://gitlab.com/bache-klever/skills.git"
      },
      "autoUpdate": true
    }
  },
  "sandbox": {
    "network": {
      "allowedDomains": [
        "gitlab.com",
        "github.com"
      ],
      "allowLocalBinding": true
    },
    "filesystem": {
      "allowWrite": [
        "/private/var/folders/*/*/T/*",
        "/private/var/folders/*/*/T/*/*",
        "/private/var/folders/*/*/T/*/*/*"
      ],
      "denyRead": [
        "~/.cargo/credentials.toml",
        "~/.cargo/credentials"
      ],
      "allowRead": [
        "~/.rustup",
        "~/.cargo",
        "~/.local/bin",
        "~/.local/share/uv",
        "~/.local/share/mise",
        "~/.venvs",
        "~/.config/glab-agent"
      ]
    }
  },
  "feedbackDrafts": "off",
  "effortLevel": "high",
  "modelSettings": {
    "claude-sonnet-5": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "high"
    },
    "claude-fable-5-2": {
      "effortLevel": "high"
    }
  },
  "awaySummaryEnabled": false,
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "switchModelsOnFlag": false,
  "agentPushNotifEnabled": true
}
