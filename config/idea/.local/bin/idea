#!/usr/bin/env bash
# idea — capture and pick up backlog ideas as GitHub or GitLab issues.
# See config/idea/README.md in the dotfiles repo.
set -euo pipefail
IFS=$'\n\t'

# Color is opt-in: only when stderr is a TTY and NO_COLOR is unset. Decided
# once at load so each log_* stays a single printf.
if [[ -t 2 && -z "${NO_COLOR:-}" ]]; then
  readonly _IDEA_C_RED=$'\033[31m'
  readonly _IDEA_C_YELLOW=$'\033[33m'
  readonly _IDEA_C_CYAN=$'\033[36m'
  readonly _IDEA_C_RESET=$'\033[0m'
else
  readonly _IDEA_C_RED='' _IDEA_C_YELLOW='' _IDEA_C_CYAN='' _IDEA_C_RESET=''
fi

idea::log()      { printf '%sidea:%s %s\n' "$_IDEA_C_CYAN"   "$_IDEA_C_RESET" "$*" >&2; }
idea::log_warn() { printf '%sidea:%s %s\n' "$_IDEA_C_YELLOW" "$_IDEA_C_RESET" "$*" >&2; }
idea::log_err()  { printf '%sidea:%s %s\n' "$_IDEA_C_RED"    "$_IDEA_C_RESET" "$*" >&2; }
idea::die()      { idea::log_err "$@"; exit 1; }

usage() {
  cat <<'USAGE'
idea — capture and pick up backlog ideas as GitHub or GitLab issues.

Usage:
  idea new <title> [--size S|M|L] [--tags a,b] [--body <text>]
                              Create an idea. The body comes from --body, from
                              stdin when it is piped, or from the provider's
                              own editor or prompt.
  idea list [filters] [--json]
                              List ideas, newest first.
  idea pick [<number>] [--yes] [filters]
                              Show an idea in full, then claim it and start.
                              Without a number, choose from the filtered list.
  idea drop    <number>       Release an idea you had claimed.
  idea done    <number>       Close an idea as done.
  idea abandon <number>       Close an idea as abandoned.
  idea reopen  <number>       Reopen a closed idea.
  idea -h | --help

Filters:
  --status <state>            open, in-progress, claimed, abandoned or done
  --tag <tag>                 repeatable; an idea must carry every tag given
  --size S|M|L

Ideas live as issues on this repository's origin remote — github.com through
gh, gitlab.com through glab. The matching CLI must be installed and
authenticated.
USAGE
}

# Set once per invocation by idea::detect.
IDEA_PROVIDER=''   # github | gitlab
IDEA_CLI=''        # gh | glab
IDEA_REPO=''       # owner/repo, pinned explicitly on every repo-scoped call

# Read the provider and owner/repo out of origin's URL. Handles https://,
# ssh://, scp-style (git@host:owner/repo), embedded userinfo and a trailing
# .git. The repo is always taken from origin and passed explicitly afterwards,
# so neither CLI's own default-repository resolution can redirect a call to a
# fork's upstream.
idea::detect() {
  local url rest host sep path
  if ! url=$(git remote get-url origin 2>/dev/null) || [[ -z "$url" ]]; then
    idea::die "no 'origin' remote here — idea keeps ideas as issues on origin, so it needs one"
  fi

  rest="${url#*://}"      # scheme, when there is one
  rest="${rest##*@}"      # userinfo, when there is one
  host="${rest%%[:/]*}"
  sep="${rest:${#host}:1}"
  path="${rest:$((${#host} + 1))}"
  # ssh://host:port/owner/repo — drop the port, but never a numeric owner
  # reached through the scp-style or https forms.
  if [[ "$sep" == ":" && "$url" == *://* && "$path" =~ ^[0-9]+/ ]]; then
    path="${path#*/}"
  fi
  path="${path%/}"
  path="${path%.git}"
  host=$(printf '%s' "$host" | tr '[:upper:]' '[:lower:]')

  case "$host" in
    github.com) IDEA_PROVIDER='github'; IDEA_CLI='gh' ;;
    gitlab.com) IDEA_PROVIDER='gitlab'; IDEA_CLI='glab' ;;
    '') idea::die "could not read a host out of origin's URL: ${url}" ;;
    *)  idea::die "origin is on ${host}; idea supports github.com and gitlab.com only" ;;
  esac

  [[ -n "$path" && "$path" == */* ]] ||
    idea::die "could not read owner/repo out of origin's URL: ${url}"
  IDEA_REPO="$path"
}

# Fail early and by name: a CLI that is missing or logged out is the first
# thing a new machine hits, and finding out halfway through a multi-call
# subcommand is worse than finding out before the first one.
idea::preflight() {
  command -v "$IDEA_CLI" >/dev/null 2>&1 ||
    idea::die "${IDEA_CLI} is not installed — idea needs it to reach ${IDEA_PROVIDER}"
  "$IDEA_CLI" auth status >/dev/null 2>&1 ||
    idea::die "${IDEA_CLI} is not authenticated — run '${IDEA_CLI} auth login'"
}

# Well above either provider's 30-item default, which would otherwise truncate
# any backlog worth having a tool for.
readonly IDEA_FETCH_LIMIT=200

# Records move between the fetch, the filter and the renderers separated by
# ASCII unit separator rather than by tab: `read` folds runs of tabs together,
# because a tab is IFS whitespace, which would silently shift every field after
# an issue with no assignee, no size or no tags.
readonly IDEA_SEP=$'\037'

# The current user's own login, looked up once per run. `@me` cannot stand in
# for it: neither provider will compare that shorthand against the assignee
# list an issue actually returns.
IDEA_LOGIN=''
idea::ensure_login() {
  [[ -n "$IDEA_LOGIN" ]] && return 0
  if [[ "$IDEA_PROVIDER" == "github" ]]; then
    IDEA_LOGIN=$("$IDEA_CLI" api user --jq '.login')
  else
    IDEA_LOGIN=$("$IDEA_CLI" api user --jq '.username')
  fi
  [[ -n "$IDEA_LOGIN" ]] ||
    idea::die "could not read your ${IDEA_PROVIDER} login from '${IDEA_CLI} api user'"
}

# True when a comma-separated list contains an exact item.
idea::list_has() {
  local needle="$1" rest="$2" item
  while [[ -n "$rest" ]]; do
    item="${rest%%,*}"
    if [[ "$item" == "$rest" ]]; then rest=''; else rest="${rest#*,}"; fi
    [[ "$item" == "$needle" ]] && return 0
  done
  return 1
}

# Split a label list into the size marker and the plain tags, leaving them in
# IDEA_ROW_SIZE and IDEA_ROW_TAGS. Both are read once per issue, so writing
# them here keeps a subshell out of the row loop. The lifecycle labels get
# their own columns and so are not repeated among the tags.
IDEA_ROW_SIZE=''
IDEA_ROW_TAGS=''
idea::split_labels() {
  local rest="$1" item
  IDEA_ROW_SIZE=''
  IDEA_ROW_TAGS=''
  while [[ -n "$rest" ]]; do
    item="${rest%%,*}"
    if [[ "$item" == "$rest" ]]; then rest=''; else rest="${rest#*,}"; fi
    case "$item" in
      '') ;;
      size:*) IDEA_ROW_SIZE="${item#size:}" ;;
      abandoned) ;;
      *) IDEA_ROW_TAGS="${IDEA_ROW_TAGS:+${IDEA_ROW_TAGS},}${item}" ;;
    esac
  done
}

# The jq expression flattening one issue into number, state, assignees, labels
# and title. Both CLIs carry their own jq, so extraction rides along with the
# fetch and `idea` needs none of its own; keeping the expression here means the
# two providers' field names differ in exactly one place. Labels arrive as
# objects from one and as plain strings from the other, so both are accepted.
idea::row_expr() {
  local number_field='.iid' login_field='.username'
  if [[ "$IDEA_PROVIDER" == "github" ]]; then
    number_field='.number'
    login_field='.login'
  fi
  printf '%s' "[(${number_field}|tostring), (.state|ascii_downcase), \
([(.assignees // [])[] | ${login_field}] | join(\",\")), \
([(.labels // [])[] | if type == \"object\" then .name else . end] | join(\",\")), \
(.title // \"\")] | @tsv"
}

# Every issue, one record each. The only server-side narrowing is the page size
# and the state span; every lifecycle decision is made here instead, from the
# same three fields on both providers, so `--status` cannot come to mean two
# different things depending on which one you are on.
idea::provider_rows() {
  if [[ "$IDEA_PROVIDER" == "github" ]]; then
    "$IDEA_CLI" issue list --repo "$IDEA_REPO" --state all --limit "$IDEA_FETCH_LIMIT" \
      --json number,state,assignees,labels,title --jq ".[] | $(idea::row_expr)"
  else
    "$IDEA_CLI" issue list --repo "$IDEA_REPO" --all --per-page "$IDEA_FETCH_LIMIT" \
      --output json --jq ".[] | $(idea::row_expr)"
  fi
}

# The same record for a single issue, so `pick` and `reopen` read an issue's
# assignees and labels through exactly the same shape `list` classifies.
idea::issue_meta() {
  local number="$1"
  if [[ "$IDEA_PROVIDER" == "github" ]]; then
    "$IDEA_CLI" issue view "$number" --repo "$IDEA_REPO" \
      --json number,state,assignees,labels,title --jq "$(idea::row_expr)"
  else
    "$IDEA_CLI" issue view "$number" --repo "$IDEA_REPO" \
      --output json --jq "$(idea::row_expr)"
  fi
}

# One tab-separated record per issue: number, lifecycle state, size, tags,
# title — newest first.
# Derive an issue's lifecycle state into IDEA_ROW_STATE. Nothing stores it:
# open versus closed, who is assigned and whether the abandoned label is on it
# are all the platform's own atomic, immediately-visible facts. The abandoned
# test comes before done so a closed issue can never answer to both.
IDEA_ROW_STATE=''
idea::lifecycle() {
  local state="$1" assignees="$2" labels="$3"
  if [[ "$state" == "open" || "$state" == "opened" ]]; then
    if [[ -z "$assignees" ]]; then
      IDEA_ROW_STATE='open'
    elif idea::list_has "$IDEA_LOGIN" "$assignees"; then
      IDEA_ROW_STATE='in-progress'
    else
      IDEA_ROW_STATE='claimed'
    fi
  elif idea::list_has 'abandoned' "$labels"; then
    IDEA_ROW_STATE='abandoned'
  else
    IDEA_ROW_STATE='done'
  fi
}

idea::classified_rows() {
  local number state assignees labels title
  idea::ensure_login
  while IFS="$IDEA_SEP" read -r number state assignees labels title; do
    [[ -n "$number" ]] || continue
    idea::split_labels "$labels"
    idea::lifecycle "$state" "$assignees" "$labels"
    printf '%s%s%s%s%s%s%s%s%s\n' \
      "$number" "$IDEA_SEP" "$IDEA_ROW_STATE" "$IDEA_SEP" "$IDEA_ROW_SIZE" \
      "$IDEA_SEP" "$IDEA_ROW_TAGS" "$IDEA_SEP" "$title"
  done < <(idea::provider_rows | tr '\t' "$IDEA_SEP") | sort -t "$IDEA_SEP" -k1,1nr
}

# The issue reference among a subcommand's arguments, stepping over the values
# that belong to filter flags, so `pick --status open 9` is checked too.
idea::positional_ref() {
  local skip_next=0 arg
  for arg in "$@"; do
    if [[ "$skip_next" -eq 1 ]]; then
      skip_next=0
      continue
    fi
    case "$arg" in
      --status|--tag|--size) skip_next=1 ;;
      -*) ;;
      *) printf '%s' "$arg"; return 0 ;;
    esac
  done
  return 0
}

idea::require_number() {
  local ref="${1:-}"
  [[ -n "$ref" ]] || idea::die "this command needs an issue number"
  [[ "$ref" =~ ^[0-9]+$ ]] ||
    idea::die "'${ref}' is not an issue number — idea takes the bare number, such as 42"
}

idea::valid_status() {
  case "$1" in
    open|in-progress|claimed|abandoned|done) return 0 ;;
    *) return 1 ;;
  esac
}

# Normalise a size argument to S, M or L, or fail.
idea::normalise_size() {
  local size
  size=$(printf '%s' "$1" | tr '[:lower:]' '[:upper:]')
  case "$size" in
    S|M|L) printf '%s' "$size" ;;
    *) idea::die "--size takes S, M or L (got: ${1})" ;;
  esac
}

idea::json_escape() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\t'/\\t}"
  s="${s//$'\r'/\\r}"
  printf '%s' "$s"
}

# Filter classified rows on stdin: status, size, then every tag given.
idea::filter_rows() {
  local f_status="$1" f_size="$2"
  shift 2
  local number state size tags title tag keep
  while IFS="$IDEA_SEP" read -r number state size tags title; do
    [[ -n "$f_status" && "$state" != "$f_status" ]] && continue
    [[ -n "$f_size" && "$size" != "$f_size" ]] && continue
    keep=1
    for tag in "$@"; do
      idea::list_has "$tag" "$tags" || { keep=0; break; }
    done
    [[ "$keep" -eq 1 ]] || continue
    printf '%s%s%s%s%s%s%s%s%s\n' \
      "$number" "$IDEA_SEP" "$state" "$IDEA_SEP" "$size" \
      "$IDEA_SEP" "$tags" "$IDEA_SEP" "$title"
  done
}

idea::render_rows() {
  local number state size tags title
  while IFS="$IDEA_SEP" read -r number state size tags title; do
    [[ -n "$number" ]] || continue
    printf '%-5s %-11s %-4s %-16s %s\n' \
      "#${number}" "$state" "${size:--}" "${tags:--}" "$title"
  done
}

idea::render_rows_json() {
  local number state size tags title first=1 size_json tags_json rest item
  printf '['
  while IFS="$IDEA_SEP" read -r number state size tags title; do
    [[ "$first" -eq 1 ]] && first=0 || printf ','
    size_json='null'
    [[ -n "$size" ]] && size_json="\"$(idea::json_escape "$size")\""
    tags_json=''
    rest="$tags"
    while [[ -n "$rest" ]]; do
      item="${rest%%,*}"
      if [[ "$item" == "$rest" ]]; then rest=''; else rest="${rest#*,}"; fi
      tags_json="${tags_json:+${tags_json}, }\"$(idea::json_escape "$item")\""
    done
    printf '\n  {"number": %s, "state": "%s", "size": %s, "tags": [%s], "title": "%s"}' \
      "$number" "$state" "$size_json" "$tags_json" "$(idea::json_escape "$title")"
  done
  [[ "$first" -eq 1 ]] || printf '\n'
  printf ']\n'
}

idea::cmd_list() {
  local status='' size='' json=0
  local -a tags=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --status) status="${2:-}"; shift 2 ;;
      --tag) tags+=("${2:-}"); shift 2 ;;
      --size) size="${2:-}"; shift 2 ;;
      --json) json=1; shift ;;
      --) shift; break ;;
      *) idea::die "unknown argument for idea list: $1" ;;
    esac
  done
  [[ -z "$status" ]] || idea::valid_status "$status" ||
    idea::die "unknown status '${status}' — try open, in-progress, claimed, abandoned or done"
  [[ -z "$size" ]] || size=$(idea::normalise_size "$size")

  if [[ "$json" -eq 1 ]]; then
    idea::classified_rows | idea::filter_rows "$status" "$size" "${tags[@]+"${tags[@]}"}" |
      idea::render_rows_json
  else
    idea::classified_rows | idea::filter_rows "$status" "$size" "${tags[@]+"${tags[@]}"}" |
      idea::render_rows
  fi
}

# Split a comma-separated list into one trimmed, non-empty item per line.
idea::split_commas() {
  local IFS=','
  local item
  set -f
  for item in $1; do
    item="${item#"${item%%[![:space:]]*}"}"
    item="${item%"${item##*[![:space:]]}"}"
    [[ -n "$item" ]] && printf '%s\n' "$item"
  done
  set +f
}

# Make sure a label exists, by creating it and accepting the conflict. Nothing
# lists the labels first: both providers page that listing oldest-first from a
# small default, so an absent-looking label may only be out of view, and the
# create it would then trigger fails anyway. Creating unconditionally is
# idempotent and needs no listing to be complete.
idea::ensure_label() {
  local name="$1" out
  if [[ "$IDEA_PROVIDER" == "github" ]]; then
    out=$("$IDEA_CLI" label create "$name" --repo "$IDEA_REPO" 2>&1) && return 0
  else
    out=$("$IDEA_CLI" label create --name "$name" --repo "$IDEA_REPO" 2>&1) && return 0
  fi
  if printf '%s' "$out" | grep -Eqi 'already[ _]exists'; then
    return 0
  fi
  idea::log_err "could not create the label '${name}':"
  printf '%s\n' "$out" >&2
  exit 1
}

idea::cmd_new() {
  local title='' size='' tags='' body='' have_body=0 label tag
  local -a labels=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --size) size="${2:-}"; shift 2 ;;
      --tags) tags="${2:-}"; shift 2 ;;
      --body) body="${2:-}"; have_body=1; shift 2 ;;
      --) shift; break ;;
      -*) idea::die "unknown flag for idea new: $1" ;;
      *)
        [[ -z "$title" ]] || idea::die "idea new takes a single title; quote it if it has spaces"
        title="$1"; shift ;;
    esac
  done
  [[ -n "$title" ]] || idea::die "idea new requires a title"

  if [[ -n "$size" ]]; then
    size=$(idea::normalise_size "$size")
    labels+=("size:${size}")
  fi
  while IFS= read -r tag; do
    labels+=("$tag")
  done < <(idea::split_commas "$tags")

  if [[ ${#labels[@]} -gt 0 ]]; then
    for label in "${labels[@]}"; do
      idea::ensure_label "$label"
    done
  fi

  # A piped body is content the caller already drafted; a terminal means they
  # have not, so the provider's own prompt or editor is left to ask.
  if [[ "$have_body" -eq 0 && ! -t 0 ]]; then
    body=$(cat)
    have_body=1
  fi

  local -a args=(issue create --repo "$IDEA_REPO" --title "$title")
  if [[ ${#labels[@]} -gt 0 ]]; then
    for label in "${labels[@]}"; do
      args+=(--label "$label")
    done
  fi

  if [[ "$IDEA_PROVIDER" == "github" ]]; then
    if [[ "$have_body" -eq 1 ]]; then
      printf '%s' "$body" | "$IDEA_CLI" "${args[@]}" --body-file -
    else
      "$IDEA_CLI" "${args[@]}"
    fi
  else
    if [[ "$have_body" -eq 1 ]]; then
      # glab reads a lone `-` as "open an editor", the opposite of gh's "read
      # stdin", so the body travels as a literal argument — and a body that is
      # itself just `-` gets a space so it cannot be read as that sentinel.
      [[ "$body" == "-" ]] && body="- "
      "$IDEA_CLI" "${args[@]}" --description "$body" --yes
    else
      "$IDEA_CLI" "${args[@]}"
    fi
  fi
}

idea::issue_body() {
  if [[ "$IDEA_PROVIDER" == "github" ]]; then
    "$IDEA_CLI" issue view "$1" --repo "$IDEA_REPO" --json body --jq '.body'
  else
    "$IDEA_CLI" issue view "$1" --repo "$IDEA_REPO" --output json --jq '.description'
  fi
}

idea::confirm() {
  local reply=''
  printf '%s [y/N] ' "$1" >&2
  read -r reply || return 1
  [[ "$reply" == [yY] || "$reply" == [yY][eE][sS] ]]
}

# Choose one issue from the filtered rows, printing its number.
idea::select_issue() {
  local rows="$1" line choice index=0 number state size tags title
  local -a numbers=()
  if command -v fzf >/dev/null 2>&1; then
    line=$(printf '%s\n' "$rows" | idea::render_rows | fzf --no-sort --prompt='idea> ') || line=''
    if [[ -z "$line" ]]; then
      idea::log_err "nothing selected"
      return 1
    fi
    line="${line%% *}"
    printf '%s' "${line#\#}"
    return 0
  fi
  while IFS="$IDEA_SEP" read -r number state size tags title; do
    [[ -n "$number" ]] || continue
    index=$((index + 1))
    numbers+=("$number")
    printf '%3d) %-5s %-11s %-4s %-16s %s\n' \
      "$index" "#${number}" "$state" "${size:--}" "${tags:--}" "$title" >&2
  done <<< "$rows"
  printf 'pick one [1-%d]: ' "$index" >&2
  read -r choice || choice=''
  if ! [[ "$choice" =~ ^[0-9]+$ ]] || [[ "$choice" -lt 1 || "$choice" -gt "$index" ]]; then
    idea::log_err "'${choice}' is not one of the numbers offered"
    return 1
  fi
  printf '%s' "${numbers[$((choice - 1))]}"
}

# The issue's body is printed before the question is asked, always — including
# on the --yes path. Anyone can open an issue on a public repository, so that
# text is third-party writing about to be handed to an agent as seed content,
# and reading it first is the one review step between the two.
idea::cmd_pick() {
  local number='' yes=0 status='' size='' rows
  local -a tags=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --yes) yes=1; shift ;;
      --status) status="${2:-}"; shift 2 ;;
      --tag) tags+=("${2:-}"); shift 2 ;;
      --size) size="${2:-}"; shift 2 ;;
      --) shift; break ;;
      -*) idea::die "unknown flag for idea pick: $1" ;;
      *)
        [[ -z "$number" ]] || idea::die "idea pick takes a single issue number"
        number="$1"; shift ;;
    esac
  done
  [[ -z "$status" ]] || idea::valid_status "$status" ||
    idea::die "unknown status '${status}' — try open, in-progress, claimed, abandoned or done"
  [[ -z "$size" ]] || size=$(idea::normalise_size "$size")

  idea::ensure_login

  if [[ -z "$number" ]]; then
    rows=$(idea::classified_rows | idea::filter_rows "$status" "$size" "${tags[@]+"${tags[@]}"}")
    [[ -n "$rows" ]] || idea::die "no ideas match those filters"
    number=$(idea::select_issue "$rows") || exit 1
  fi

  local meta_number state assignees labels title
  IFS="$IDEA_SEP" read -r meta_number state assignees labels title \
    < <(idea::issue_meta "$number" | tr '\t' "$IDEA_SEP")
  [[ -n "$meta_number" ]] || idea::die "could not read issue ${number} from ${IDEA_PROVIDER}"
  idea::split_labels "$labels"
  idea::lifecycle "$state" "$assignees" "$labels"

  printf '%s%s%s%s%s%s%s%s%s\n' \
    "$meta_number" "$IDEA_SEP" "$IDEA_ROW_STATE" "$IDEA_SEP" "$IDEA_ROW_SIZE" \
    "$IDEA_SEP" "$IDEA_ROW_TAGS" "$IDEA_SEP" "$title" | idea::render_rows
  printf '\n'
  idea::issue_body "$number"
  printf '\n'

  # Someone else holding it is a warning, not a wall: this is a single-user
  # tool and the assignee is only standing in for "being worked on".
  local prompt='start work on this idea?'
  if [[ -n "$assignees" ]] && ! idea::list_has "$IDEA_LOGIN" "$assignees"; then
    idea::log_warn "already assigned to ${assignees}"
    prompt="already assigned to ${assignees} — start work on it anyway?"
  fi
  if [[ "$yes" -ne 1 ]]; then
    idea::confirm "$prompt" || { idea::log "left #${number} as it was"; return 0; }
  fi

  if [[ "$IDEA_PROVIDER" == "github" ]]; then
    "$IDEA_CLI" issue edit "$number" --repo "$IDEA_REPO" --add-assignee "$IDEA_LOGIN"
  else
    "$IDEA_CLI" issue update "$number" --repo "$IDEA_REPO" --assignee="+${IDEA_LOGIN}"
  fi

  # The skill takes it from here into pair-programming itself, so it sets
  # IDEA_FROM_SKILL and this pointer stays out of its way.
  if [[ -z "${IDEA_FROM_SKILL:-}" ]]; then
    idea::log "claimed #${number} — open a Claude Code session in this repo and ask it to pick idea #${number} to build it"
  fi
}

idea::cmd_done() {
  "$IDEA_CLI" issue close "$1" --repo "$IDEA_REPO"
}

idea::cmd_abandon() {
  local number="$1"
  idea::ensure_label 'abandoned'
  if [[ "$IDEA_PROVIDER" == "github" ]]; then
    "$IDEA_CLI" issue edit "$number" --repo "$IDEA_REPO" --add-label abandoned
  else
    "$IDEA_CLI" issue update "$number" --repo "$IDEA_REPO" --label abandoned
  fi
  "$IDEA_CLI" issue close "$number" --repo "$IDEA_REPO"
}

# Give up only this user's own claim. GitLab's bare `--assignee <user>` would
# replace the whole assignee list and `--unassign` would empty it, so the
# scoped `-<user>` form is the only one that touches nothing `idea` did not do.
idea::cmd_drop() {
  local number="$1"
  idea::ensure_login
  if [[ "$IDEA_PROVIDER" == "github" ]]; then
    "$IDEA_CLI" issue edit "$number" --repo "$IDEA_REPO" --remove-assignee "$IDEA_LOGIN"
  else
    "$IDEA_CLI" issue update "$number" --repo "$IDEA_REPO" --assignee="-${IDEA_LOGIN}"
  fi
}

idea::cmd_reopen() {
  local number="$1" state assignees labels title
  local -a edit=()
  idea::ensure_login
  IFS="$IDEA_SEP" read -r number state assignees labels title \
    < <(idea::issue_meta "$number" | tr '\t' "$IDEA_SEP")
  [[ -n "$number" ]] || idea::die "could not read issue ${1} from ${IDEA_PROVIDER}"

  "$IDEA_CLI" issue reopen "$number" --repo "$IDEA_REPO"

  if idea::list_has "$IDEA_LOGIN" "$assignees"; then
    if [[ "$IDEA_PROVIDER" == "github" ]]; then
      edit+=(--remove-assignee "$IDEA_LOGIN")
    else
      edit+=("--assignee=-${IDEA_LOGIN}")
    fi
  fi
  if idea::list_has 'abandoned' "$labels"; then
    if [[ "$IDEA_PROVIDER" == "github" ]]; then
      edit+=(--remove-label abandoned)
    else
      edit+=(--unlabel abandoned)
    fi
  fi
  [[ ${#edit[@]} -gt 0 ]] || return 0

  if [[ "$IDEA_PROVIDER" == "github" ]]; then
    "$IDEA_CLI" issue edit "$number" --repo "$IDEA_REPO" "${edit[@]}"
  else
    "$IDEA_CLI" issue update "$number" --repo "$IDEA_REPO" "${edit[@]}"
  fi
}

main() {
  local cmd="${1:-}"
  case "$cmd" in
    ''|-h|--help) usage; return 0 ;;
    new|list|pick|done|abandon|reopen|drop) shift ;;
    *) idea::log_err "unknown command: ${cmd}"; usage; exit 1 ;;
  esac

  # Identifiers are checked before anything reaches the network, so a mistyped
  # reference cannot become a call against some other repository's issue.
  local ref
  case "$cmd" in
    done|abandon|reopen|drop) idea::require_number "${1:-}" ;;
    pick)
      ref=$(idea::positional_ref "$@")
      [[ -z "$ref" ]] || idea::require_number "$ref" ;;
  esac

  idea::detect
  idea::preflight

  case "$cmd" in
    new)     idea::cmd_new     "$@" ;;
    list)    idea::cmd_list    "$@" ;;
    pick)    idea::cmd_pick    "$@" ;;
    done)    idea::cmd_done    "$@" ;;
    abandon) idea::cmd_abandon "$@" ;;
    reopen)  idea::cmd_reopen  "$@" ;;
    drop)    idea::cmd_drop    "$@" ;;
  esac
}

main "$@"
