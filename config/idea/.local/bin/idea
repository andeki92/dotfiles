#!/usr/bin/env bash
# idea — capture and pick up backlog ideas as GitHub or GitLab issues.
# See config/idea/README.md in the dotfiles repo.
set -euo pipefail
IFS=$'\n\t'

# Color is opt-in: only when stderr is a TTY and NO_COLOR is unset. Decided
# once at load so each log_* stays a single printf.
if [[ -t 2 && -z "${NO_COLOR:-}" ]]; then
  readonly _IDEA_C_RED=$'\033[31m'
  readonly _IDEA_C_YELLOW=$'\033[33m'
  readonly _IDEA_C_CYAN=$'\033[36m'
  readonly _IDEA_C_RESET=$'\033[0m'
else
  readonly _IDEA_C_RED='' _IDEA_C_YELLOW='' _IDEA_C_CYAN='' _IDEA_C_RESET=''
fi

idea::log()      { printf '%sidea:%s %s\n' "$_IDEA_C_CYAN"   "$_IDEA_C_RESET" "$*" >&2; }
idea::log_warn() { printf '%sidea:%s %s\n' "$_IDEA_C_YELLOW" "$_IDEA_C_RESET" "$*" >&2; }
idea::log_err()  { printf '%sidea:%s %s\n' "$_IDEA_C_RED"    "$_IDEA_C_RESET" "$*" >&2; }
idea::die()      { idea::log_err "$@"; exit 1; }

usage() {
  cat <<'USAGE'
idea — capture and pick up backlog ideas as GitHub or GitLab issues.

Usage:
  idea new <title> [--size S|M|L] [--tags a,b] [--body <text>]
                              Create an idea. The body comes from --body, from
                              stdin when it is piped, or from the provider's
                              own editor or prompt.
  idea done <number>          Close an idea as done.
  idea -h | --help

Ideas live as issues on this repository's origin remote — github.com through
gh, gitlab.com through glab. The matching CLI must be installed and
authenticated.
USAGE
}

# Set once per invocation by idea::detect.
IDEA_PROVIDER=''   # github | gitlab
IDEA_CLI=''        # gh | glab
IDEA_REPO=''       # owner/repo, pinned explicitly on every repo-scoped call

# Read the provider and owner/repo out of origin's URL. Handles https://,
# ssh://, scp-style (git@host:owner/repo), embedded userinfo and a trailing
# .git. The repo is always taken from origin and passed explicitly afterwards,
# so neither CLI's own default-repository resolution can redirect a call to a
# fork's upstream.
idea::detect() {
  local url rest host sep path
  if ! url=$(git remote get-url origin 2>/dev/null) || [[ -z "$url" ]]; then
    idea::die "no 'origin' remote here — idea keeps ideas as issues on origin, so it needs one"
  fi

  rest="${url#*://}"      # scheme, when there is one
  rest="${rest##*@}"      # userinfo, when there is one
  host="${rest%%[:/]*}"
  sep="${rest:${#host}:1}"
  path="${rest:$((${#host} + 1))}"
  # ssh://host:port/owner/repo — drop the port, but never a numeric owner
  # reached through the scp-style or https forms.
  if [[ "$sep" == ":" && "$url" == *://* && "$path" =~ ^[0-9]+/ ]]; then
    path="${path#*/}"
  fi
  path="${path%/}"
  path="${path%.git}"
  host=$(printf '%s' "$host" | tr '[:upper:]' '[:lower:]')

  case "$host" in
    github.com) IDEA_PROVIDER='github'; IDEA_CLI='gh' ;;
    gitlab.com) IDEA_PROVIDER='gitlab'; IDEA_CLI='glab' ;;
    '') idea::die "could not read a host out of origin's URL: ${url}" ;;
    *)  idea::die "origin is on ${host}; idea supports github.com and gitlab.com only" ;;
  esac

  [[ -n "$path" && "$path" == */* ]] ||
    idea::die "could not read owner/repo out of origin's URL: ${url}"
  IDEA_REPO="$path"
}

# Fail early and by name: a CLI that is missing or logged out is the first
# thing a new machine hits, and finding out halfway through a multi-call
# subcommand is worse than finding out before the first one.
idea::preflight() {
  command -v "$IDEA_CLI" >/dev/null 2>&1 ||
    idea::die "${IDEA_CLI} is not installed — idea needs it to reach ${IDEA_PROVIDER}"
  "$IDEA_CLI" auth status >/dev/null 2>&1 ||
    idea::die "${IDEA_CLI} is not authenticated — run '${IDEA_CLI} auth login'"
}

# Split a comma-separated list into one trimmed, non-empty item per line.
idea::split_commas() {
  local IFS=','
  local item
  set -f
  for item in $1; do
    item="${item#"${item%%[![:space:]]*}"}"
    item="${item%"${item##*[![:space:]]}"}"
    [[ -n "$item" ]] && printf '%s\n' "$item"
  done
  set +f
}

# Make sure a label exists, by creating it and accepting the conflict. Nothing
# lists the labels first: both providers page that listing oldest-first from a
# small default, so an absent-looking label may only be out of view, and the
# create it would then trigger fails anyway. Creating unconditionally is
# idempotent and needs no listing to be complete.
idea::ensure_label() {
  local name="$1" out
  if [[ "$IDEA_PROVIDER" == "github" ]]; then
    out=$("$IDEA_CLI" label create "$name" --repo "$IDEA_REPO" 2>&1) && return 0
  else
    out=$("$IDEA_CLI" label create --name "$name" --repo "$IDEA_REPO" 2>&1) && return 0
  fi
  if printf '%s' "$out" | grep -Eqi 'already[ _]exists'; then
    return 0
  fi
  idea::log_err "could not create the label '${name}':"
  printf '%s\n' "$out" >&2
  exit 1
}

idea::cmd_new() {
  local title='' size='' tags='' body='' have_body=0 label tag
  local -a labels=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --size) size="${2:-}"; shift 2 ;;
      --tags) tags="${2:-}"; shift 2 ;;
      --body) body="${2:-}"; have_body=1; shift 2 ;;
      --) shift; break ;;
      -*) idea::die "unknown flag for idea new: $1" ;;
      *)
        [[ -z "$title" ]] || idea::die "idea new takes a single title; quote it if it has spaces"
        title="$1"; shift ;;
    esac
  done
  [[ -n "$title" ]] || idea::die "idea new requires a title"

  if [[ -n "$size" ]]; then
    size=$(printf '%s' "$size" | tr '[:lower:]' '[:upper:]')
    case "$size" in
      S|M|L) labels+=("size:${size}") ;;
      *) idea::die "--size takes S, M or L (got: ${size})" ;;
    esac
  fi
  while IFS= read -r tag; do
    labels+=("$tag")
  done < <(idea::split_commas "$tags")

  if [[ ${#labels[@]} -gt 0 ]]; then
    for label in "${labels[@]}"; do
      idea::ensure_label "$label"
    done
  fi

  # A piped body is content the caller already drafted; a terminal means they
  # have not, so the provider's own prompt or editor is left to ask.
  if [[ "$have_body" -eq 0 && ! -t 0 ]]; then
    body=$(cat)
    have_body=1
  fi

  local -a args=(issue create --repo "$IDEA_REPO" --title "$title")
  if [[ ${#labels[@]} -gt 0 ]]; then
    for label in "${labels[@]}"; do
      args+=(--label "$label")
    done
  fi

  if [[ "$IDEA_PROVIDER" == "github" ]]; then
    if [[ "$have_body" -eq 1 ]]; then
      printf '%s' "$body" | "$IDEA_CLI" "${args[@]}" --body-file -
    else
      "$IDEA_CLI" "${args[@]}"
    fi
  else
    if [[ "$have_body" -eq 1 ]]; then
      # glab reads a lone `-` as "open an editor", the opposite of gh's "read
      # stdin", so the body travels as a literal argument — and a body that is
      # itself just `-` gets a space so it cannot be read as that sentinel.
      [[ "$body" == "-" ]] && body="- "
      "$IDEA_CLI" "${args[@]}" --description "$body" --yes
    else
      "$IDEA_CLI" "${args[@]}"
    fi
  fi
}

idea::cmd_done() {
  local number="${1:?idea done requires an issue number}"
  "$IDEA_CLI" issue close "$number" --repo "$IDEA_REPO"
}

main() {
  local cmd="${1:-}"
  case "$cmd" in
    ''|-h|--help) usage; return 0 ;;
    new|done) shift ;;
    *) idea::log_err "unknown command: ${cmd}"; usage; exit 1 ;;
  esac

  idea::detect
  idea::preflight

  case "$cmd" in
    new)  idea::cmd_new  "$@" ;;
    done) idea::cmd_done "$@" ;;
  esac
}

main "$@"
