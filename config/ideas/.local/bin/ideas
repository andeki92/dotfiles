#!/usr/bin/env bash
# ideas — capture and pick up backlog ideas as GitHub or GitLab issues.
# See config/ideas/README.md in the dotfiles repo.
set -euo pipefail
IFS=$'\n\t'

# Color is opt-in: only when stderr is a TTY and NO_COLOR is unset. Decided
# once at load so each log_* stays a single printf.
if [[ -t 2 && -z "${NO_COLOR:-}" ]]; then
  readonly _IDEAS_C_RED=$'\033[31m'
  readonly _IDEAS_C_YELLOW=$'\033[33m'
  readonly _IDEAS_C_CYAN=$'\033[36m'
  readonly _IDEAS_C_RESET=$'\033[0m'
else
  readonly _IDEAS_C_RED='' _IDEAS_C_YELLOW='' _IDEAS_C_CYAN='' _IDEAS_C_RESET=''
fi

ideas::log()      { printf '%sideas:%s %s\n' "$_IDEAS_C_CYAN"   "$_IDEAS_C_RESET" "$*" >&2; }
ideas::log_warn() { printf '%sideas:%s %s\n' "$_IDEAS_C_YELLOW" "$_IDEAS_C_RESET" "$*" >&2; }
ideas::log_err()  { printf '%sideas:%s %s\n' "$_IDEAS_C_RED"    "$_IDEAS_C_RESET" "$*" >&2; }
ideas::die()      { ideas::log_err "$@"; exit 1; }

usage() {
  cat <<'USAGE'
ideas — capture and pick up backlog ideas as GitHub or GitLab issues.

Usage:
  ideas new <title> [--size S|M|L] [--tags a,b] [--body <text>]
                              Create an idea. The body comes from --body, from
                              stdin when it is piped, or from the provider's
                              own editor or prompt.
  ideas list [filters] [--json]
                              List ideas, newest first.
  ideas pick [<number>] [--yes] [filters]
                              Show an idea in full, then claim it and start.
                              Without a number, choose from the filtered list.
  ideas drop    <number>      Release an idea you had claimed.
  ideas done    <number>      Close an idea as done.
  ideas abandon <number>      Close an idea as abandoned.
  ideas reopen  <number>      Reopen a closed idea.
  ideas -h | --help

Filters:
  --status <state>            open, in-progress, claimed, abandoned or done
  --tag <tag>                 repeatable; an idea must carry every tag given
  --size S|M|L

Ideas live as issues on this repository's origin remote — github.com through
gh, gitlab.com through glab. The matching CLI must be installed and
authenticated.
USAGE
}

# Set once per invocation by ideas::detect.
IDEAS_PROVIDER=''   # github | gitlab
IDEAS_CLI=''        # gh | glab
IDEAS_REPO=''       # owner/repo, pinned explicitly on every repo-scoped call

# Read the provider and owner/repo out of origin's URL. Handles https://,
# ssh://, scp-style (git@host:owner/repo), embedded userinfo and a trailing
# .git. The repo is always taken from origin and passed explicitly afterwards,
# so neither CLI's own default-repository resolution can redirect a call to a
# fork's upstream.
ideas::detect() {
  local url rest host sep path
  if ! url=$(git remote get-url origin 2>/dev/null) || [[ -z "$url" ]]; then
    ideas::die "no 'origin' remote here — ideas keeps them as issues on origin, so it needs one"
  fi

  rest="${url#*://}"      # scheme, when there is one
  rest="${rest##*@}"      # userinfo, when there is one
  host="${rest%%[:/]*}"
  sep="${rest:${#host}:1}"
  path="${rest:$((${#host} + 1))}"
  # ssh://host:port/owner/repo — drop the port, but never a numeric owner
  # reached through the scp-style or https forms.
  if [[ "$sep" == ":" && "$url" == *://* && "$path" =~ ^[0-9]+/ ]]; then
    path="${path#*/}"
  fi
  path="${path%/}"
  path="${path%.git}"
  host=$(printf '%s' "$host" | tr '[:upper:]' '[:lower:]')

  case "$host" in
    github.com) IDEAS_PROVIDER='github'; IDEAS_CLI='gh' ;;
    gitlab.com) IDEAS_PROVIDER='gitlab'; IDEAS_CLI='glab' ;;
    '') ideas::die "could not read a host out of origin's URL: ${url}" ;;
    *)  ideas::die "origin is on ${host}; ideas supports github.com and gitlab.com only" ;;
  esac

  [[ -n "$path" && "$path" == */* ]] ||
    ideas::die "could not read owner/repo out of origin's URL: ${url}"
  IDEAS_REPO="$path"
}

# Fail early and by name: a CLI that is missing or logged out is the first
# thing a new machine hits, and finding out halfway through a multi-call
# subcommand is worse than finding out before the first one.
ideas::preflight() {
  command -v "$IDEAS_CLI" >/dev/null 2>&1 ||
    ideas::die "${IDEAS_CLI} is not installed — ideas needs it to reach ${IDEAS_PROVIDER}"
  "$IDEAS_CLI" auth status >/dev/null 2>&1 ||
    ideas::die "${IDEAS_CLI} is not authenticated — run '${IDEAS_CLI} auth login'"
}

# Well above either provider's 30-item default, which would otherwise truncate
# any backlog worth having a tool for.
readonly IDEAS_FETCH_LIMIT=200

# Records move between the fetch, the filter and the renderers separated by
# ASCII unit separator rather than by tab: `read` folds runs of tabs together,
# because a tab is IFS whitespace, which would silently shift every field after
# an issue with no assignee, no size or no tags.
readonly IDEAS_SEP=$'\037'

# The current user's own login, looked up once per run. `@me` cannot stand in
# for it: neither provider will compare that shorthand against the assignee
# list an issue actually returns.
IDEAS_LOGIN=''
ideas::ensure_login() {
  [[ -n "$IDEAS_LOGIN" ]] && return 0
  if [[ "$IDEAS_PROVIDER" == "github" ]]; then
    IDEAS_LOGIN=$("$IDEAS_CLI" api user --jq '.login')
  else
    IDEAS_LOGIN=$("$IDEAS_CLI" api user --jq '.username')
  fi
  [[ -n "$IDEAS_LOGIN" ]] ||
    ideas::die "could not read your ${IDEAS_PROVIDER} login from '${IDEAS_CLI} api user'"
}

# True when a comma-separated list contains an exact item.
ideas::list_has() {
  local needle="$1" rest="$2" item
  while [[ -n "$rest" ]]; do
    item="${rest%%,*}"
    if [[ "$item" == "$rest" ]]; then rest=''; else rest="${rest#*,}"; fi
    [[ "$item" == "$needle" ]] && return 0
  done
  return 1
}

# Split a label list into the size marker and the plain tags, leaving them in
# IDEAS_ROW_SIZE and IDEAS_ROW_TAGS. Both are read once per issue, so writing
# them here keeps a subshell out of the row loop. The lifecycle labels get
# their own columns and so are not repeated among the tags.
IDEAS_ROW_SIZE=''
IDEAS_ROW_TAGS=''
ideas::split_labels() {
  local rest="$1" item
  IDEAS_ROW_SIZE=''
  IDEAS_ROW_TAGS=''
  while [[ -n "$rest" ]]; do
    item="${rest%%,*}"
    if [[ "$item" == "$rest" ]]; then rest=''; else rest="${rest#*,}"; fi
    case "$item" in
      '') ;;
      size:*) IDEAS_ROW_SIZE="${item#size:}" ;;
      abandoned) ;;
      *) IDEAS_ROW_TAGS="${IDEAS_ROW_TAGS:+${IDEAS_ROW_TAGS},}${item}" ;;
    esac
  done
}

# The jq expression flattening one issue into number, state, assignees, labels
# and title. Both CLIs carry their own jq, so extraction rides along with the
# fetch and `ideas` needs none of its own; keeping the expression here means the
# two providers' field names differ in exactly one place. Labels arrive as
# objects from one and as plain strings from the other, so both are accepted.
ideas::row_expr() {
  local number_field='.iid' login_field='.username'
  if [[ "$IDEAS_PROVIDER" == "github" ]]; then
    number_field='.number'
    login_field='.login'
  fi
  printf '%s' "[(${number_field}|tostring), (.state|ascii_downcase), \
([(.assignees // [])[] | ${login_field}] | join(\",\")), \
([(.labels // [])[] | if type == \"object\" then .name else . end] | join(\",\")), \
(.title // \"\")] | @tsv"
}

# Every issue, one record each. The only server-side narrowing is the page size
# and the state span; every lifecycle decision is made here instead, from the
# same three fields on both providers, so `--status` cannot come to mean two
# different things depending on which one you are on.
ideas::provider_rows() {
  if [[ "$IDEAS_PROVIDER" == "github" ]]; then
    "$IDEAS_CLI" issue list --repo "$IDEAS_REPO" --state all --limit "$IDEAS_FETCH_LIMIT" \
      --json number,state,assignees,labels,title --jq ".[] | $(ideas::row_expr)"
  else
    "$IDEAS_CLI" issue list --repo "$IDEAS_REPO" --all --per-page "$IDEAS_FETCH_LIMIT" \
      --output json --jq ".[] | $(ideas::row_expr)"
  fi
}

# The same record for a single issue, so `pick` and `reopen` read an issue's
# assignees and labels through exactly the same shape `list` classifies.
ideas::issue_meta() {
  local number="$1"
  if [[ "$IDEAS_PROVIDER" == "github" ]]; then
    "$IDEAS_CLI" issue view "$number" --repo "$IDEAS_REPO" \
      --json number,state,assignees,labels,title --jq "$(ideas::row_expr)"
  else
    "$IDEAS_CLI" issue view "$number" --repo "$IDEAS_REPO" \
      --output json --jq "$(ideas::row_expr)"
  fi
}

# Derive an issue's lifecycle state into IDEAS_ROW_STATE. Nothing stores it:
# open versus closed, who is assigned and whether the abandoned label is on it
# are all the platform's own atomic, immediately-visible facts. The abandoned
# test comes before done so a closed issue can never answer to both.
IDEAS_ROW_STATE=''
ideas::lifecycle() {
  local state="$1" assignees="$2" labels="$3"
  if [[ "$state" == "open" || "$state" == "opened" ]]; then
    if [[ -z "$assignees" ]]; then
      IDEAS_ROW_STATE='open'
    elif ideas::list_has "$IDEAS_LOGIN" "$assignees"; then
      IDEAS_ROW_STATE='in-progress'
    else
      IDEAS_ROW_STATE='claimed'
    fi
  elif ideas::list_has 'abandoned' "$labels"; then
    IDEAS_ROW_STATE='abandoned'
  else
    IDEAS_ROW_STATE='done'
  fi
}

# One record per issue: number, lifecycle state, size, tags, title — newest
# first.
ideas::classified_rows() {
  local number state assignees labels title
  ideas::ensure_login
  while IFS="$IDEAS_SEP" read -r number state assignees labels title; do
    [[ -n "$number" ]] || continue
    ideas::split_labels "$labels"
    ideas::lifecycle "$state" "$assignees" "$labels"
    printf '%s%s%s%s%s%s%s%s%s\n' \
      "$number" "$IDEAS_SEP" "$IDEAS_ROW_STATE" "$IDEAS_SEP" "$IDEAS_ROW_SIZE" \
      "$IDEAS_SEP" "$IDEAS_ROW_TAGS" "$IDEAS_SEP" "$title"
  done < <(ideas::provider_rows | tr '\t' "$IDEAS_SEP") | sort -t "$IDEAS_SEP" -k1,1nr
}

# The issue reference among a subcommand's arguments, stepping over the values
# that belong to filter flags, so `pick --status open 9` is checked too.
ideas::positional_ref() {
  local skip_next=0 arg
  for arg in "$@"; do
    if [[ "$skip_next" -eq 1 ]]; then
      skip_next=0
      continue
    fi
    case "$arg" in
      --status|--tag|--size) skip_next=1 ;;
      -*) ;;
      *) printf '%s' "$arg"; return 0 ;;
    esac
  done
  return 0
}

ideas::require_number() {
  local ref="${1:-}"
  [[ -n "$ref" ]] || ideas::die "this command needs an issue number"
  [[ "$ref" =~ ^[0-9]+$ ]] ||
    ideas::die "'${ref}' is not an issue number — ideas takes the bare number, such as 42"
}

ideas::valid_status() {
  case "$1" in
    open|in-progress|claimed|abandoned|done) return 0 ;;
    *) return 1 ;;
  esac
}

# Normalise a size argument to S, M or L, or fail.
ideas::normalise_size() {
  local size
  size=$(printf '%s' "$1" | tr '[:lower:]' '[:upper:]')
  case "$size" in
    S|M|L) printf '%s' "$size" ;;
    *) ideas::die "--size takes S, M or L (got: ${1})" ;;
  esac
}

ideas::json_escape() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\t'/\\t}"
  s="${s//$'\r'/\\r}"
  printf '%s' "$s"
}

# Filter classified rows on stdin: status, size, then every tag given.
ideas::filter_rows() {
  local f_status="$1" f_size="$2"
  shift 2
  local number state size tags title tag keep
  while IFS="$IDEAS_SEP" read -r number state size tags title; do
    [[ -n "$f_status" && "$state" != "$f_status" ]] && continue
    [[ -n "$f_size" && "$size" != "$f_size" ]] && continue
    keep=1
    for tag in "$@"; do
      ideas::list_has "$tag" "$tags" || { keep=0; break; }
    done
    [[ "$keep" -eq 1 ]] || continue
    printf '%s%s%s%s%s%s%s%s%s\n' \
      "$number" "$IDEAS_SEP" "$state" "$IDEAS_SEP" "$size" \
      "$IDEAS_SEP" "$tags" "$IDEAS_SEP" "$title"
  done
}

ideas::render_rows() {
  local number state size tags title
  while IFS="$IDEAS_SEP" read -r number state size tags title; do
    [[ -n "$number" ]] || continue
    printf '%-5s %-11s %-4s %-16s %s\n' \
      "#${number}" "$state" "${size:--}" "${tags:--}" "$title"
  done
}

ideas::render_rows_json() {
  local number state size tags title first=1 size_json tags_json rest item
  printf '['
  while IFS="$IDEAS_SEP" read -r number state size tags title; do
    [[ "$first" -eq 1 ]] && first=0 || printf ','
    size_json='null'
    [[ -n "$size" ]] && size_json="\"$(ideas::json_escape "$size")\""
    tags_json=''
    rest="$tags"
    while [[ -n "$rest" ]]; do
      item="${rest%%,*}"
      if [[ "$item" == "$rest" ]]; then rest=''; else rest="${rest#*,}"; fi
      tags_json="${tags_json:+${tags_json}, }\"$(ideas::json_escape "$item")\""
    done
    printf '\n  {"number": %s, "state": "%s", "size": %s, "tags": [%s], "title": "%s"}' \
      "$number" "$state" "$size_json" "$tags_json" "$(ideas::json_escape "$title")"
  done
  [[ "$first" -eq 1 ]] || printf '\n'
  printf ']\n'
}

ideas::cmd_list() {
  local status='' size='' json=0
  local -a tags=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --status) status="${2:-}"; shift 2 ;;
      --tag) tags+=("${2:-}"); shift 2 ;;
      --size) size="${2:-}"; shift 2 ;;
      --json) json=1; shift ;;
      --) shift; break ;;
      *) ideas::die "unknown argument for ideas list: $1" ;;
    esac
  done
  [[ -z "$status" ]] || ideas::valid_status "$status" ||
    ideas::die "unknown status '${status}' — try open, in-progress, claimed, abandoned or done"
  [[ -z "$size" ]] || size=$(ideas::normalise_size "$size")

  if [[ "$json" -eq 1 ]]; then
    ideas::classified_rows | ideas::filter_rows "$status" "$size" "${tags[@]+"${tags[@]}"}" |
      ideas::render_rows_json
  else
    ideas::classified_rows | ideas::filter_rows "$status" "$size" "${tags[@]+"${tags[@]}"}" |
      ideas::render_rows
  fi
}

# Split a comma-separated list into one trimmed, non-empty item per line.
ideas::split_commas() {
  local IFS=','
  local item
  set -f
  for item in $1; do
    item="${item#"${item%%[![:space:]]*}"}"
    item="${item%"${item##*[![:space:]]}"}"
    [[ -n "$item" ]] && printf '%s\n' "$item"
  done
  set +f
}

# Make sure a label exists, by creating it and accepting the conflict. Nothing
# lists the labels first: both providers page that listing oldest-first from a
# small default, so an absent-looking label may only be out of view, and the
# create it would then trigger fails anyway. Creating unconditionally is
# idempotent and needs no listing to be complete.
ideas::ensure_label() {
  local name="$1" out
  if [[ "$IDEAS_PROVIDER" == "github" ]]; then
    out=$("$IDEAS_CLI" label create "$name" --repo "$IDEAS_REPO" 2>&1) && return 0
  else
    out=$("$IDEAS_CLI" label create --name "$name" --repo "$IDEAS_REPO" 2>&1) && return 0
  fi
  if printf '%s' "$out" | grep -Eqi 'already[ _]exists'; then
    return 0
  fi
  ideas::log_err "could not create the label '${name}':"
  printf '%s\n' "$out" >&2
  exit 1
}

ideas::cmd_new() {
  local title='' size='' tags='' body='' have_body=0 label tag
  local -a labels=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --size) size="${2:-}"; shift 2 ;;
      --tags) tags="${2:-}"; shift 2 ;;
      --body) body="${2:-}"; have_body=1; shift 2 ;;
      --) shift; break ;;
      -*) ideas::die "unknown flag for ideas new: $1" ;;
      *)
        [[ -z "$title" ]] || ideas::die "ideas new takes a single title; quote it if it has spaces"
        title="$1"; shift ;;
    esac
  done
  [[ -n "$title" ]] || ideas::die "ideas new requires a title"

  if [[ -n "$size" ]]; then
    size=$(ideas::normalise_size "$size")
    labels+=("size:${size}")
  fi
  while IFS= read -r tag; do
    labels+=("$tag")
  done < <(ideas::split_commas "$tags")

  if [[ ${#labels[@]} -gt 0 ]]; then
    for label in "${labels[@]}"; do
      ideas::ensure_label "$label"
    done
  fi

  # A piped body is content the caller already drafted; a terminal means they
  # have not, so the provider's own prompt or editor is left to ask.
  if [[ "$have_body" -eq 0 && ! -t 0 ]]; then
    body=$(cat)
    have_body=1
  fi

  local -a args=(issue create --repo "$IDEAS_REPO" --title "$title")
  if [[ ${#labels[@]} -gt 0 ]]; then
    for label in "${labels[@]}"; do
      args+=(--label "$label")
    done
  fi

  if [[ "$IDEAS_PROVIDER" == "github" ]]; then
    if [[ "$have_body" -eq 1 ]]; then
      printf '%s' "$body" | "$IDEAS_CLI" "${args[@]}" --body-file -
    else
      "$IDEAS_CLI" "${args[@]}"
    fi
  else
    if [[ "$have_body" -eq 1 ]]; then
      # glab reads a lone `-` as "open an editor", the opposite of gh's "read
      # stdin", so the body travels as a literal argument — and a body that is
      # itself just `-` gets a space so it cannot be read as that sentinel.
      [[ "$body" == "-" ]] && body="- "
      "$IDEAS_CLI" "${args[@]}" --description "$body" --yes
    else
      "$IDEAS_CLI" "${args[@]}"
    fi
  fi
}

ideas::issue_body() {
  if [[ "$IDEAS_PROVIDER" == "github" ]]; then
    "$IDEAS_CLI" issue view "$1" --repo "$IDEAS_REPO" --json body --jq '.body'
  else
    "$IDEAS_CLI" issue view "$1" --repo "$IDEAS_REPO" --output json --jq '.description'
  fi
}

ideas::confirm() {
  local reply=''
  printf '%s [y/N] ' "$1" >&2
  read -r reply || return 1
  [[ "$reply" == [yY] || "$reply" == [yY][eE][sS] ]]
}

# Choose one issue from the filtered rows, printing its number.
ideas::select_issue() {
  local rows="$1" line choice index=0 number state size tags title
  local -a numbers=()
  if command -v fzf >/dev/null 2>&1; then
    line=$(printf '%s\n' "$rows" | ideas::render_rows | fzf --no-sort --prompt='ideas> ') || line=''
    if [[ -z "$line" ]]; then
      ideas::log_err "nothing selected"
      return 1
    fi
    line="${line%% *}"
    printf '%s' "${line#\#}"
    return 0
  fi
  while IFS="$IDEAS_SEP" read -r number state size tags title; do
    [[ -n "$number" ]] || continue
    index=$((index + 1))
    numbers+=("$number")
    printf '%3d) %-5s %-11s %-4s %-16s %s\n' \
      "$index" "#${number}" "$state" "${size:--}" "${tags:--}" "$title" >&2
  done <<< "$rows"
  printf 'pick one [1-%d]: ' "$index" >&2
  read -r choice || choice=''
  if ! [[ "$choice" =~ ^[0-9]+$ ]] || [[ "$choice" -lt 1 || "$choice" -gt "$index" ]]; then
    ideas::log_err "'${choice}' is not one of the numbers offered"
    return 1
  fi
  printf '%s' "${numbers[$((choice - 1))]}"
}

# The issue's body is printed before the question is asked, always — including
# on the --yes path. Anyone can open an issue on a public repository, so that
# text is third-party writing about to be handed to an agent as seed content,
# and reading it first is the one review step between the two.
ideas::cmd_pick() {
  local number='' yes=0 status='' size='' rows
  local -a tags=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --yes) yes=1; shift ;;
      --status) status="${2:-}"; shift 2 ;;
      --tag) tags+=("${2:-}"); shift 2 ;;
      --size) size="${2:-}"; shift 2 ;;
      --) shift; break ;;
      -*) ideas::die "unknown flag for ideas pick: $1" ;;
      *)
        [[ -z "$number" ]] || ideas::die "ideas pick takes a single issue number"
        number="$1"; shift ;;
    esac
  done
  [[ -z "$status" ]] || ideas::valid_status "$status" ||
    ideas::die "unknown status '${status}' — try open, in-progress, claimed, abandoned or done"
  [[ -z "$size" ]] || size=$(ideas::normalise_size "$size")

  ideas::ensure_login

  if [[ -z "$number" ]]; then
    rows=$(ideas::classified_rows | ideas::filter_rows "$status" "$size" "${tags[@]+"${tags[@]}"}")
    [[ -n "$rows" ]] || ideas::die "no ideas match those filters"
    number=$(ideas::select_issue "$rows") || exit 1
  fi

  local meta_number state assignees labels title
  IFS="$IDEAS_SEP" read -r meta_number state assignees labels title \
    < <(ideas::issue_meta "$number" | tr '\t' "$IDEAS_SEP")
  [[ -n "$meta_number" ]] || ideas::die "could not read issue ${number} from ${IDEAS_PROVIDER}"
  ideas::split_labels "$labels"
  ideas::lifecycle "$state" "$assignees" "$labels"

  printf '%s%s%s%s%s%s%s%s%s\n' \
    "$meta_number" "$IDEAS_SEP" "$IDEAS_ROW_STATE" "$IDEAS_SEP" "$IDEAS_ROW_SIZE" \
    "$IDEAS_SEP" "$IDEAS_ROW_TAGS" "$IDEAS_SEP" "$title" | ideas::render_rows
  printf '\n'
  ideas::issue_body "$number"
  printf '\n'

  # Someone else holding it is a warning, not a wall: this is a single-user
  # tool and the assignee is only standing in for "being worked on".
  local prompt='start work on this idea?'
  if [[ -n "$assignees" ]] && ! ideas::list_has "$IDEAS_LOGIN" "$assignees"; then
    ideas::log_warn "already assigned to ${assignees}"
    prompt="already assigned to ${assignees} — start work on it anyway?"
  fi
  if [[ "$yes" -ne 1 ]]; then
    ideas::confirm "$prompt" || { ideas::log "left #${number} as it was"; return 0; }
  fi

  if [[ "$IDEAS_PROVIDER" == "github" ]]; then
    "$IDEAS_CLI" issue edit "$number" --repo "$IDEAS_REPO" --add-assignee "$IDEAS_LOGIN"
  else
    "$IDEAS_CLI" issue update "$number" --repo "$IDEAS_REPO" --assignee="+${IDEAS_LOGIN}"
  fi

  # The skill takes it from here into pair-programming itself, so it sets
  # IDEAS_FROM_SKILL and this pointer stays out of its way.
  if [[ -z "${IDEAS_FROM_SKILL:-}" ]]; then
    ideas::log "claimed #${number} — open a Claude Code session in this repo and ask it to pick idea #${number} to build it"
  fi
}

ideas::cmd_done() {
  "$IDEAS_CLI" issue close "$1" --repo "$IDEAS_REPO"
}

ideas::cmd_abandon() {
  local number="$1"
  ideas::ensure_label 'abandoned'
  if [[ "$IDEAS_PROVIDER" == "github" ]]; then
    "$IDEAS_CLI" issue edit "$number" --repo "$IDEAS_REPO" --add-label abandoned
  else
    "$IDEAS_CLI" issue update "$number" --repo "$IDEAS_REPO" --label abandoned
  fi
  "$IDEAS_CLI" issue close "$number" --repo "$IDEAS_REPO"
}

# Give up only this user's own claim. GitLab's bare `--assignee <user>` would
# replace the whole assignee list and `--unassign` would empty it, so the
# scoped `-<user>` form is the only one that touches nothing `ideas` did not do.
ideas::cmd_drop() {
  local number="$1"
  ideas::ensure_login
  if [[ "$IDEAS_PROVIDER" == "github" ]]; then
    "$IDEAS_CLI" issue edit "$number" --repo "$IDEAS_REPO" --remove-assignee "$IDEAS_LOGIN"
  else
    "$IDEAS_CLI" issue update "$number" --repo "$IDEAS_REPO" --assignee="-${IDEAS_LOGIN}"
  fi
}

ideas::cmd_reopen() {
  local number="$1" state assignees labels title
  local -a edit=()
  ideas::ensure_login
  IFS="$IDEAS_SEP" read -r number state assignees labels title \
    < <(ideas::issue_meta "$number" | tr '\t' "$IDEAS_SEP")
  [[ -n "$number" ]] || ideas::die "could not read issue ${1} from ${IDEAS_PROVIDER}"

  "$IDEAS_CLI" issue reopen "$number" --repo "$IDEAS_REPO"

  if ideas::list_has "$IDEAS_LOGIN" "$assignees"; then
    if [[ "$IDEAS_PROVIDER" == "github" ]]; then
      edit+=(--remove-assignee "$IDEAS_LOGIN")
    else
      edit+=("--assignee=-${IDEAS_LOGIN}")
    fi
  fi
  if ideas::list_has 'abandoned' "$labels"; then
    if [[ "$IDEAS_PROVIDER" == "github" ]]; then
      edit+=(--remove-label abandoned)
    else
      edit+=(--unlabel abandoned)
    fi
  fi
  [[ ${#edit[@]} -gt 0 ]] || return 0

  if [[ "$IDEAS_PROVIDER" == "github" ]]; then
    "$IDEAS_CLI" issue edit "$number" --repo "$IDEAS_REPO" "${edit[@]}"
  else
    "$IDEAS_CLI" issue update "$number" --repo "$IDEAS_REPO" "${edit[@]}"
  fi
}

main() {
  local cmd="${1:-}"
  case "$cmd" in
    ''|-h|--help) usage; return 0 ;;
    new|list|pick|done|abandon|reopen|drop) shift ;;
    *) ideas::log_err "unknown command: ${cmd}"; usage; exit 1 ;;
  esac

  # Identifiers are checked before anything reaches the network, so a mistyped
  # reference cannot become a call against some other repository's issue.
  local ref
  case "$cmd" in
    done|abandon|reopen|drop) ideas::require_number "${1:-}" ;;
    pick)
      ref=$(ideas::positional_ref "$@")
      [[ -z "$ref" ]] || ideas::require_number "$ref" ;;
  esac

  ideas::detect
  ideas::preflight

  case "$cmd" in
    new)     ideas::cmd_new     "$@" ;;
    list)    ideas::cmd_list    "$@" ;;
    pick)    ideas::cmd_pick    "$@" ;;
    done)    ideas::cmd_done    "$@" ;;
    abandon) ideas::cmd_abandon "$@" ;;
    reopen)  ideas::cmd_reopen  "$@" ;;
    drop)    ideas::cmd_drop    "$@" ;;
  esac
}

main "$@"
